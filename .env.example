NODE_ENV=development
APP_NAME=NestJS Inventory System
HOST=0.0.0.0
PORT=3000
API_PREFIX=api/v1
CORS_ORIGINS=http://localhost:4200

POSTGRES_DB=inventory
POSTGRES_USER=inventory
POSTGRES_PASSWORD=inventory
DATABASE_URL=postgresql://inventory:inventory@localhost:5432/inventory?schema=public

JWT_ACCESS_SECRET=change-me-access-secret-minimum-32-characters
JWT_REFRESH_SECRET=change-me-refresh-secret-minimum-32-characters
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800
JWT_ISSUER=nest-js-inventory-system
JWT_AUDIENCE=angular-inventory-system

# Optional: used only by npm run db:seed to create the first administrator.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_FIRST_NAME=System
BOOTSTRAP_ADMIN_LAST_NAME=Administrator
