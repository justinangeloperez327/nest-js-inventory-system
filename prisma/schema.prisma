generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String         @id @default(uuid()) @db.Uuid
  email         String         @unique
  passwordHash  String         @map("password_hash")
  firstName     String         @map("first_name")
  lastName      String         @map("last_name")
  isActive      Boolean        @default(true) @map("is_active")
  lastLoginAt   DateTime?      @map("last_login_at") @db.Timestamptz(3)
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  roles         UserRole[]
  auditLogs     AuditLog[]
  refreshTokens               RefreshToken[]
  stockMovements              StockMovement[]
  createdInventoryAdjustments InventoryAdjustment[] @relation("InventoryAdjustmentCreatedBy")
  postedInventoryAdjustments  InventoryAdjustment[] @relation("InventoryAdjustmentPostedBy")
  createdInventoryTransfers   InventoryTransfer[]   @relation("InventoryTransferCreatedBy")
  postedInventoryTransfers    InventoryTransfer[]   @relation("InventoryTransferPostedBy")

  @@map("users")
}

model RefreshToken {
  id                String    @id @default(uuid()) @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  tokenHash         String    @map("token_hash")
  expiresAt         DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt         DateTime? @map("revoked_at") @db.Timestamptz(3)
  replacedByTokenId String?   @map("replaced_by_token_id") @db.Uuid
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model Role {
  id          String           @id @default(uuid()) @db.Uuid
  name        String           @unique
  description String?
  isSystem    Boolean          @default(false) @map("is_system")
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  users       UserRole[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String           @id @default(uuid()) @db.Uuid
  key         String           @unique
  description String?
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  roles       RolePermission[]

  @@map("permissions")
}

model UserRole {
  userId     String   @map("user_id") @db.Uuid
  roleId     String   @map("role_id") @db.Uuid
  assignedAt DateTime @default(now()) @map("assigned_at") @db.Timestamptz(3)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String     @map("role_id") @db.Uuid
  permissionId String     @map("permission_id") @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model Category {
  id          String    @id @default(uuid()) @db.Uuid
  code        String    @unique
  name        String    @unique
  description String?
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  products    Product[]

  @@map("categories")
}

model Unit {
  id        String    @id @default(uuid()) @db.Uuid
  code      String    @unique
  name      String    @unique
  symbol    String    @unique
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  products  Product[]

  @@map("units")
}

model Product {
  id           String          @id @default(uuid()) @db.Uuid
  sku          String          @unique
  barcode      String?         @unique
  name         String
  description  String?
  categoryId   String?         @map("category_id") @db.Uuid
  unitId       String?         @map("unit_id") @db.Uuid
  costPrice    Decimal         @default(0) @map("cost_price") @db.Decimal(19, 4)
  sellingPrice Decimal         @default(0) @map("selling_price") @db.Decimal(19, 4)
  minimumStock Decimal         @default(0) @map("minimum_stock") @db.Decimal(19, 4)
  reorderPoint Decimal         @default(0) @map("reorder_point") @db.Decimal(19, 4)
  maximumStock Decimal?        @map("maximum_stock") @db.Decimal(19, 4)
  isTrackable  Boolean         @default(true) @map("is_trackable")
  isActive     Boolean         @default(true) @map("is_active")
  createdAt    DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  category     Category?       @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  unit         Unit?           @relation(fields: [unitId], references: [id], onDelete: SetNull)
  inventory            InventoryItem[]
  stockMovements       StockMovement[]
  inventoryAdjustments InventoryAdjustment[]
  inventoryTransferLines InventoryTransferLine[]

  @@index([categoryId])
  @@index([unitId])
  @@index([name])
  @@map("products")
}

model Warehouse {
  id          String          @id @default(uuid()) @db.Uuid
  code        String          @unique
  name        String
  description String?
  location    String?
  isActive    Boolean         @default(true) @map("is_active")
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  inventory            InventoryItem[]
  stockMovements       StockMovement[]
  inventoryAdjustments InventoryAdjustment[]
  outboundTransfers     InventoryTransfer[] @relation("InventoryTransferSource")
  inboundTransfers      InventoryTransfer[] @relation("InventoryTransferDestination")

  @@index([name])
  @@map("warehouses")
}

model InventoryItem {
  id               String    @id @default(uuid()) @db.Uuid
  productId        String    @map("product_id") @db.Uuid
  warehouseId      String    @map("warehouse_id") @db.Uuid
  quantityOnHand   Decimal   @default(0) @map("quantity_on_hand") @db.Decimal(19, 4)
  quantityReserved Decimal   @default(0) @map("quantity_reserved") @db.Decimal(19, 4)
  averageCost      Decimal   @default(0) @map("average_cost") @db.Decimal(19, 4)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  product          Product   @relation(fields: [productId], references: [id], onDelete: Restrict)
  warehouse        Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)

  @@unique([productId, warehouseId])
  @@index([warehouseId])
  @@map("inventory_items")
}

model SystemSetting {
  id        String   @id @default(uuid()) @db.Uuid
  key       String   @unique
  value     Json
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("system_settings")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String?  @map("user_id") @db.Uuid
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id")
  before     Json?
  after      Json?
  ipAddress  String?  @map("ip_address")
  requestId  String?  @map("request_id")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}


enum StockMovementType {
  RECEIPT
  SALE
  TRANSFER_IN
  TRANSFER_OUT
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  RETURN_IN
  RETURN_OUT
  STOCK_COUNT
}

model StockMovement {
  id                String            @id @default(uuid()) @db.Uuid
  productId         String            @map("product_id") @db.Uuid
  warehouseId       String            @map("warehouse_id") @db.Uuid
  type              StockMovementType
  quantityChange    Decimal           @map("quantity_change") @db.Decimal(19, 4)
  unitCost          Decimal?          @map("unit_cost") @db.Decimal(19, 4)
  balanceBefore     Decimal           @map("balance_before") @db.Decimal(19, 4)
  balanceAfter      Decimal           @map("balance_after") @db.Decimal(19, 4)
  referenceType     String?           @map("reference_type")
  referenceId       String?           @map("reference_id")
  referenceNumber   String?           @map("reference_number")
  referencePath     String?           @map("reference_path")
  notes             String?
  occurredAt        DateTime          @default(now()) @map("occurred_at") @db.Timestamptz(3)
  performedByUserId String?           @map("performed_by_user_id") @db.Uuid
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  product           Product           @relation(fields: [productId], references: [id], onDelete: Restrict)
  warehouse         Warehouse         @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  performedBy         User?                 @relation(fields: [performedByUserId], references: [id], onDelete: Restrict)
  inventoryAdjustment InventoryAdjustment?
  outboundTransferLine InventoryTransferLine? @relation("InventoryTransferOutboundMovement")
  inboundTransferLine  InventoryTransferLine? @relation("InventoryTransferInboundMovement")

  @@index([productId, occurredAt])
  @@index([warehouseId, occurredAt])
  @@index([type, occurredAt])
  @@index([referenceType, referenceId])
  @@index([referenceNumber])
  @@index([performedByUserId])
  @@index([occurredAt])
  @@map("stock_movements")
}


enum InventoryAdjustmentDirection {
  INCREASE
  DECREASE
}

enum InventoryAdjustmentStatus {
  DRAFT
  POSTED
  CANCELLED
}

model InventoryAdjustment {
  id              String                       @id @default(uuid()) @db.Uuid
  number          String                       @unique
  productId       String                       @map("product_id") @db.Uuid
  warehouseId     String                       @map("warehouse_id") @db.Uuid
  direction       InventoryAdjustmentDirection
  quantity        Decimal                      @db.Decimal(19, 4)
  reasonCode      String                       @map("reason_code")
  notes           String?
  status          InventoryAdjustmentStatus    @default(DRAFT)
  balanceBefore   Decimal?                     @map("balance_before") @db.Decimal(19, 4)
  balanceAfter    Decimal?                     @map("balance_after") @db.Decimal(19, 4)
  movementId      String?                      @unique @map("movement_id") @db.Uuid
  createdByUserId String                       @map("created_by_user_id") @db.Uuid
  postedByUserId  String?                      @map("posted_by_user_id") @db.Uuid
  postedAt        DateTime?                    @map("posted_at") @db.Timestamptz(3)
  createdAt       DateTime                     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime                     @updatedAt @map("updated_at") @db.Timestamptz(3)
  product         Product                      @relation(fields: [productId], references: [id], onDelete: Restrict)
  warehouse       Warehouse                    @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  movement        StockMovement?               @relation(fields: [movementId], references: [id], onDelete: Restrict)
  createdBy       User                         @relation("InventoryAdjustmentCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  postedBy        User?                        @relation("InventoryAdjustmentPostedBy", fields: [postedByUserId], references: [id], onDelete: Restrict)

  @@index([productId, createdAt])
  @@index([warehouseId, createdAt])
  @@index([status, createdAt])
  @@index([direction, createdAt])
  @@index([createdByUserId])
  @@index([postedByUserId])
  @@map("inventory_adjustments")
}


enum InventoryTransferStatus {
  DRAFT
  POSTED
  CANCELLED
}

model InventoryTransfer {
  id                     String                  @id @default(uuid()) @db.Uuid
  number                 String                  @unique
  sourceWarehouseId      String                  @map("source_warehouse_id") @db.Uuid
  destinationWarehouseId String                  @map("destination_warehouse_id") @db.Uuid
  notes                  String?
  status                 InventoryTransferStatus @default(DRAFT)
  createdByUserId        String                  @map("created_by_user_id") @db.Uuid
  postedByUserId         String?                 @map("posted_by_user_id") @db.Uuid
  postedAt               DateTime?               @map("posted_at") @db.Timestamptz(3)
  createdAt              DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime                @updatedAt @map("updated_at") @db.Timestamptz(3)
  sourceWarehouse        Warehouse               @relation("InventoryTransferSource", fields: [sourceWarehouseId], references: [id], onDelete: Restrict)
  destinationWarehouse   Warehouse               @relation("InventoryTransferDestination", fields: [destinationWarehouseId], references: [id], onDelete: Restrict)
  createdBy              User                    @relation("InventoryTransferCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  postedBy               User?                   @relation("InventoryTransferPostedBy", fields: [postedByUserId], references: [id], onDelete: Restrict)
  lines                  InventoryTransferLine[]

  @@index([sourceWarehouseId, createdAt])
  @@index([destinationWarehouseId, createdAt])
  @@index([status, createdAt])
  @@index([createdByUserId])
  @@index([postedByUserId])
  @@map("inventory_transfers")
}

model InventoryTransferLine {
  id                       String            @id @default(uuid()) @db.Uuid
  transferId               String            @map("transfer_id") @db.Uuid
  productId                String            @map("product_id") @db.Uuid
  quantity                 Decimal           @db.Decimal(19, 4)
  sourceBalanceBefore      Decimal?          @map("source_balance_before") @db.Decimal(19, 4)
  sourceBalanceAfter       Decimal?          @map("source_balance_after") @db.Decimal(19, 4)
  destinationBalanceBefore Decimal?          @map("destination_balance_before") @db.Decimal(19, 4)
  destinationBalanceAfter  Decimal?          @map("destination_balance_after") @db.Decimal(19, 4)
  outboundMovementId       String?           @unique @map("outbound_movement_id") @db.Uuid
  inboundMovementId        String?           @unique @map("inbound_movement_id") @db.Uuid
  createdAt                DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  transfer                 InventoryTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  product                  Product           @relation(fields: [productId], references: [id], onDelete: Restrict)
  outboundMovement         StockMovement?    @relation("InventoryTransferOutboundMovement", fields: [outboundMovementId], references: [id], onDelete: Restrict)
  inboundMovement          StockMovement?    @relation("InventoryTransferInboundMovement", fields: [inboundMovementId], references: [id], onDelete: Restrict)

  @@unique([transferId, productId])
  @@index([productId])
  @@map("inventory_transfer_lines")
}
