generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String         @id @default(uuid()) @db.Uuid
  email         String         @unique
  passwordHash  String         @map("password_hash")
  firstName     String         @map("first_name")
  lastName      String         @map("last_name")
  isActive      Boolean        @default(true) @map("is_active")
  lastLoginAt   DateTime?      @map("last_login_at") @db.Timestamptz(3)
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  roles         UserRole[]
  auditLogs     AuditLog[]
  refreshTokens               RefreshToken[]
  stockMovements              StockMovement[]
  createdInventoryAdjustments InventoryAdjustment[] @relation("InventoryAdjustmentCreatedBy")
  postedInventoryAdjustments  InventoryAdjustment[] @relation("InventoryAdjustmentPostedBy")
  createdInventoryTransfers   InventoryTransfer[]   @relation("InventoryTransferCreatedBy")
  postedInventoryTransfers    InventoryTransfer[]   @relation("InventoryTransferPostedBy")
  createdPurchaseOrders       PurchaseOrder[]       @relation("PurchaseOrderCreatedBy")
  submittedPurchaseOrders     PurchaseOrder[]       @relation("PurchaseOrderSubmittedBy")
  approvedPurchaseOrders      PurchaseOrder[]       @relation("PurchaseOrderApprovedBy")
  createdGoodsReceipts        GoodsReceipt[]        @relation("GoodsReceiptCreatedBy")
  postedGoodsReceipts         GoodsReceipt[]        @relation("GoodsReceiptPostedBy")
  createdSalesOrders          SalesOrder[]          @relation("SalesOrderCreatedBy")
  confirmedSalesOrders        SalesOrder[]          @relation("SalesOrderConfirmedBy")
  cancelledSalesOrders        SalesOrder[]          @relation("SalesOrderCancelledBy")
  dispatchedSalesOrders       SalesOrder[]          @relation("SalesOrderDispatchedBy")
  completedSalesOrders        SalesOrder[]          @relation("SalesOrderCompletedBy")
  createdSalesReturns         SalesReturn[]         @relation("SalesReturnCreatedBy")
  createdStockCounts          StockCount[]          @relation("StockCountCreatedBy")
  startedStockCounts          StockCount[]          @relation("StockCountStartedBy")
  submittedStockCounts        StockCount[]          @relation("StockCountSubmittedBy")
  approvedStockCounts         StockCount[]          @relation("StockCountApprovedBy")

  @@map("users")
}

model RefreshToken {
  id                String    @id @default(uuid()) @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  tokenHash         String    @map("token_hash")
  expiresAt         DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt         DateTime? @map("revoked_at") @db.Timestamptz(3)
  replacedByTokenId String?   @map("replaced_by_token_id") @db.Uuid
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model Role {
  id          String           @id @default(uuid()) @db.Uuid
  name        String           @unique
  description String?
  isSystem    Boolean          @default(false) @map("is_system")
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  users       UserRole[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String           @id @default(uuid()) @db.Uuid
  key         String           @unique
  description String?
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  roles       RolePermission[]

  @@map("permissions")
}

model UserRole {
  userId     String   @map("user_id") @db.Uuid
  roleId     String   @map("role_id") @db.Uuid
  assignedAt DateTime @default(now()) @map("assigned_at") @db.Timestamptz(3)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String     @map("role_id") @db.Uuid
  permissionId String     @map("permission_id") @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model Category {
  id          String    @id @default(uuid()) @db.Uuid
  code        String    @unique
  name        String    @unique
  description String?
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  products    Product[]

  @@map("categories")
}

model Unit {
  id        String    @id @default(uuid()) @db.Uuid
  code      String    @unique
  name      String    @unique
  symbol    String    @unique
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  products  Product[]

  @@map("units")
}

model Product {
  id           String          @id @default(uuid()) @db.Uuid
  sku          String          @unique
  barcode      String?         @unique
  name         String
  description  String?
  categoryId   String?         @map("category_id") @db.Uuid
  unitId       String?         @map("unit_id") @db.Uuid
  costPrice    Decimal         @default(0) @map("cost_price") @db.Decimal(19, 4)
  sellingPrice Decimal         @default(0) @map("selling_price") @db.Decimal(19, 4)
  minimumStock Decimal         @default(0) @map("minimum_stock") @db.Decimal(19, 4)
  reorderPoint Decimal         @default(0) @map("reorder_point") @db.Decimal(19, 4)
  maximumStock Decimal?        @map("maximum_stock") @db.Decimal(19, 4)
  isTrackable  Boolean         @default(true) @map("is_trackable")
  isActive     Boolean         @default(true) @map("is_active")
  createdAt    DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  category     Category?       @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  unit         Unit?           @relation(fields: [unitId], references: [id], onDelete: SetNull)
  inventory            InventoryItem[]
  stockMovements       StockMovement[]
  inventoryAdjustments InventoryAdjustment[]
  inventoryTransferLines InventoryTransferLine[]
  purchaseOrderLines      PurchaseOrderLine[]
  salesOrderLines         SalesOrderLine[]
  stockCountLines         StockCountLine[]

  @@index([categoryId])
  @@index([unitId])
  @@index([name])
  @@map("products")
}

model Warehouse {
  id          String          @id @default(uuid()) @db.Uuid
  code        String          @unique
  name        String
  description String?
  location    String?
  isActive    Boolean         @default(true) @map("is_active")
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  inventory            InventoryItem[]
  stockMovements       StockMovement[]
  inventoryAdjustments InventoryAdjustment[]
  outboundTransfers     InventoryTransfer[] @relation("InventoryTransferSource")
  inboundTransfers      InventoryTransfer[] @relation("InventoryTransferDestination")
  purchaseOrders         PurchaseOrder[]
  salesOrders            SalesOrder[]
  stockCounts            StockCount[]

  @@index([name])
  @@map("warehouses")
}

model InventoryItem {
  id               String    @id @default(uuid()) @db.Uuid
  productId        String    @map("product_id") @db.Uuid
  warehouseId      String    @map("warehouse_id") @db.Uuid
  quantityOnHand   Decimal   @default(0) @map("quantity_on_hand") @db.Decimal(19, 4)
  quantityReserved Decimal   @default(0) @map("quantity_reserved") @db.Decimal(19, 4)
  averageCost      Decimal   @default(0) @map("average_cost") @db.Decimal(19, 4)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  product          Product   @relation(fields: [productId], references: [id], onDelete: Restrict)
  warehouse        Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)

  @@unique([productId, warehouseId])
  @@index([warehouseId])
  @@map("inventory_items")
}

model SystemSetting {
  id        String   @id @default(uuid()) @db.Uuid
  key       String   @unique
  value     Json
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("system_settings")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String?  @map("user_id") @db.Uuid
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id")
  before     Json?
  after      Json?
  ipAddress  String?  @map("ip_address")
  requestId  String?  @map("request_id")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([entityType, entityId])
  @@index([action, createdAt])
  @@index([entityType, createdAt])
  @@index([requestId])
  @@index([createdAt])
  @@map("audit_logs")
}


enum StockMovementType {
  RECEIPT
  SALE
  TRANSFER_IN
  TRANSFER_OUT
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  RETURN_IN
  RETURN_OUT
  STOCK_COUNT
}

model StockMovement {
  id                String            @id @default(uuid()) @db.Uuid
  productId         String            @map("product_id") @db.Uuid
  warehouseId       String            @map("warehouse_id") @db.Uuid
  type              StockMovementType
  quantityChange    Decimal           @map("quantity_change") @db.Decimal(19, 4)
  unitCost          Decimal?          @map("unit_cost") @db.Decimal(19, 4)
  balanceBefore     Decimal           @map("balance_before") @db.Decimal(19, 4)
  balanceAfter      Decimal           @map("balance_after") @db.Decimal(19, 4)
  referenceType     String?           @map("reference_type")
  referenceId       String?           @map("reference_id")
  referenceNumber   String?           @map("reference_number")
  referencePath     String?           @map("reference_path")
  notes             String?
  occurredAt        DateTime          @default(now()) @map("occurred_at") @db.Timestamptz(3)
  performedByUserId String?           @map("performed_by_user_id") @db.Uuid
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  product           Product           @relation(fields: [productId], references: [id], onDelete: Restrict)
  warehouse         Warehouse         @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  performedBy         User?                 @relation(fields: [performedByUserId], references: [id], onDelete: Restrict)
  inventoryAdjustment InventoryAdjustment?
  outboundTransferLine InventoryTransferLine? @relation("InventoryTransferOutboundMovement")
  inboundTransferLine  InventoryTransferLine? @relation("InventoryTransferInboundMovement")
  goodsReceiptLine      GoodsReceiptLine?      @relation("GoodsReceiptMovement")
  salesOrderLine        SalesOrderLine?        @relation("SalesOrderSaleMovement")
  salesReturnLine       SalesReturnLine?       @relation("SalesReturnMovement")
  stockCountLine        StockCountLine?        @relation("StockCountMovement")

  @@index([productId, occurredAt])
  @@index([warehouseId, occurredAt])
  @@index([type, occurredAt])
  @@index([referenceType, referenceId])
  @@index([referenceNumber])
  @@index([performedByUserId])
  @@index([occurredAt])
  @@map("stock_movements")
}


enum InventoryAdjustmentDirection {
  INCREASE
  DECREASE
}

enum InventoryAdjustmentStatus {
  DRAFT
  POSTED
  CANCELLED
}

model InventoryAdjustment {
  id              String                       @id @default(uuid()) @db.Uuid
  number          String                       @unique
  productId       String                       @map("product_id") @db.Uuid
  warehouseId     String                       @map("warehouse_id") @db.Uuid
  direction       InventoryAdjustmentDirection
  quantity        Decimal                      @db.Decimal(19, 4)
  reasonCode      String                       @map("reason_code")
  notes           String?
  status          InventoryAdjustmentStatus    @default(DRAFT)
  balanceBefore   Decimal?                     @map("balance_before") @db.Decimal(19, 4)
  balanceAfter    Decimal?                     @map("balance_after") @db.Decimal(19, 4)
  movementId      String?                      @unique @map("movement_id") @db.Uuid
  createdByUserId String                       @map("created_by_user_id") @db.Uuid
  postedByUserId  String?                      @map("posted_by_user_id") @db.Uuid
  postedAt        DateTime?                    @map("posted_at") @db.Timestamptz(3)
  createdAt       DateTime                     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime                     @updatedAt @map("updated_at") @db.Timestamptz(3)
  product         Product                      @relation(fields: [productId], references: [id], onDelete: Restrict)
  warehouse       Warehouse                    @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  movement        StockMovement?               @relation(fields: [movementId], references: [id], onDelete: Restrict)
  createdBy       User                         @relation("InventoryAdjustmentCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  postedBy        User?                        @relation("InventoryAdjustmentPostedBy", fields: [postedByUserId], references: [id], onDelete: Restrict)

  @@index([productId, createdAt])
  @@index([warehouseId, createdAt])
  @@index([status, createdAt])
  @@index([direction, createdAt])
  @@index([createdByUserId])
  @@index([postedByUserId])
  @@map("inventory_adjustments")
}


enum InventoryTransferStatus {
  DRAFT
  POSTED
  CANCELLED
}

model InventoryTransfer {
  id                     String                  @id @default(uuid()) @db.Uuid
  number                 String                  @unique
  sourceWarehouseId      String                  @map("source_warehouse_id") @db.Uuid
  destinationWarehouseId String                  @map("destination_warehouse_id") @db.Uuid
  notes                  String?
  status                 InventoryTransferStatus @default(DRAFT)
  createdByUserId        String                  @map("created_by_user_id") @db.Uuid
  postedByUserId         String?                 @map("posted_by_user_id") @db.Uuid
  postedAt               DateTime?               @map("posted_at") @db.Timestamptz(3)
  createdAt              DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime                @updatedAt @map("updated_at") @db.Timestamptz(3)
  sourceWarehouse        Warehouse               @relation("InventoryTransferSource", fields: [sourceWarehouseId], references: [id], onDelete: Restrict)
  destinationWarehouse   Warehouse               @relation("InventoryTransferDestination", fields: [destinationWarehouseId], references: [id], onDelete: Restrict)
  createdBy              User                    @relation("InventoryTransferCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  postedBy               User?                   @relation("InventoryTransferPostedBy", fields: [postedByUserId], references: [id], onDelete: Restrict)
  lines                  InventoryTransferLine[]

  @@index([sourceWarehouseId, createdAt])
  @@index([destinationWarehouseId, createdAt])
  @@index([status, createdAt])
  @@index([createdByUserId])
  @@index([postedByUserId])
  @@map("inventory_transfers")
}

model InventoryTransferLine {
  id                       String            @id @default(uuid()) @db.Uuid
  transferId               String            @map("transfer_id") @db.Uuid
  productId                String            @map("product_id") @db.Uuid
  quantity                 Decimal           @db.Decimal(19, 4)
  sourceBalanceBefore      Decimal?          @map("source_balance_before") @db.Decimal(19, 4)
  sourceBalanceAfter       Decimal?          @map("source_balance_after") @db.Decimal(19, 4)
  destinationBalanceBefore Decimal?          @map("destination_balance_before") @db.Decimal(19, 4)
  destinationBalanceAfter  Decimal?          @map("destination_balance_after") @db.Decimal(19, 4)
  outboundMovementId       String?           @unique @map("outbound_movement_id") @db.Uuid
  inboundMovementId        String?           @unique @map("inbound_movement_id") @db.Uuid
  createdAt                DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  transfer                 InventoryTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  product                  Product           @relation(fields: [productId], references: [id], onDelete: Restrict)
  outboundMovement         StockMovement?    @relation("InventoryTransferOutboundMovement", fields: [outboundMovementId], references: [id], onDelete: Restrict)
  inboundMovement          StockMovement?    @relation("InventoryTransferInboundMovement", fields: [inboundMovementId], references: [id], onDelete: Restrict)

  @@unique([transferId, productId])
  @@index([productId])
  @@map("inventory_transfer_lines")
}


model Supplier {
  id            String   @id @default(uuid()) @db.Uuid
  code          String   @unique
  name          String
  contactName   String?  @map("contact_name")
  email         String?
  phone         String?
  taxNumber     String?  @unique @map("tax_number")
  addressLine1  String?  @map("address_line_1")
  addressLine2  String?  @map("address_line_2")
  city          String?
  stateProvince String?  @map("state_province")
  postalCode    String?  @map("postal_code")
  countryCode   String?  @map("country_code")
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  purchaseOrders PurchaseOrder[]

  @@index([name])
  @@index([contactName])
  @@index([email])
  @@index([phone])
  @@index([countryCode])
  @@index([isActive, name])
  @@map("suppliers")
}


enum PurchaseOrderStatus {
  DRAFT
  SUBMITTED
  APPROVED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

model PurchaseOrder {
  id                String              @id @default(uuid()) @db.Uuid
  number            String              @unique
  supplierId        String              @map("supplier_id") @db.Uuid
  warehouseId       String              @map("warehouse_id") @db.Uuid
  orderDate         DateTime            @map("order_date") @db.Date
  expectedDate      DateTime?           @map("expected_date") @db.Date
  notes             String?
  status            PurchaseOrderStatus @default(DRAFT)
  subtotal          Decimal             @default(0) @db.Decimal(19, 4)
  currencyCode      String              @map("currency_code") @db.VarChar(3)
  createdByUserId   String              @map("created_by_user_id") @db.Uuid
  submittedByUserId String?             @map("submitted_by_user_id") @db.Uuid
  approvedByUserId  String?             @map("approved_by_user_id") @db.Uuid
  submittedAt       DateTime?           @map("submitted_at") @db.Timestamptz(3)
  approvedAt        DateTime?           @map("approved_at") @db.Timestamptz(3)
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)
  supplier          Supplier            @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  warehouse         Warehouse           @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  createdBy         User                @relation("PurchaseOrderCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  submittedBy       User?               @relation("PurchaseOrderSubmittedBy", fields: [submittedByUserId], references: [id], onDelete: Restrict)
  approvedBy        User?               @relation("PurchaseOrderApprovedBy", fields: [approvedByUserId], references: [id], onDelete: Restrict)
  lines             PurchaseOrderLine[]
  goodsReceipts     GoodsReceipt[]

  @@index([supplierId, orderDate])
  @@index([warehouseId, orderDate])
  @@index([status, orderDate])
  @@index([createdByUserId])
  @@index([submittedByUserId])
  @@index([approvedByUserId])
  @@index([createdAt])
  @@map("purchase_orders")
}

model PurchaseOrderLine {
  id               String        @id @default(uuid()) @db.Uuid
  purchaseOrderId  String        @map("purchase_order_id") @db.Uuid
  productId        String        @map("product_id") @db.Uuid
  quantity         Decimal       @db.Decimal(19, 4)
  unitPrice        Decimal       @map("unit_price") @db.Decimal(19, 4)
  lineTotal        Decimal       @map("line_total") @db.Decimal(19, 4)
  quantityReceived Decimal       @default(0) @map("quantity_received") @db.Decimal(19, 4)
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  purchaseOrder    PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product          Product       @relation(fields: [productId], references: [id], onDelete: Restrict)
  goodsReceiptLines GoodsReceiptLine[]

  @@unique([purchaseOrderId, productId])
  @@index([productId])
  @@map("purchase_order_lines")
}


enum GoodsReceiptStatus {
  DRAFT
  POSTED
  CANCELLED
}

model GoodsReceipt {
  id                        String             @id @default(uuid()) @db.Uuid
  number                    String             @unique
  purchaseOrderId           String             @map("purchase_order_id") @db.Uuid
  receiptDate               DateTime           @map("receipt_date") @db.Date
  supplierDeliveryReference String?            @map("supplier_delivery_reference")
  notes                     String?
  status                    GoodsReceiptStatus @default(DRAFT)
  createdByUserId           String             @map("created_by_user_id") @db.Uuid
  postedByUserId            String?            @map("posted_by_user_id") @db.Uuid
  postedAt                  DateTime?          @map("posted_at") @db.Timestamptz(3)
  createdAt                 DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                 DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  purchaseOrder             PurchaseOrder      @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict)
  createdBy                 User               @relation("GoodsReceiptCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  postedBy                  User?              @relation("GoodsReceiptPostedBy", fields: [postedByUserId], references: [id], onDelete: Restrict)
  lines                     GoodsReceiptLine[]

  @@index([purchaseOrderId, receiptDate])
  @@index([status, receiptDate])
  @@index([createdByUserId])
  @@index([postedByUserId])
  @@index([createdAt])
  @@map("goods_receipts")
}

model GoodsReceiptLine {
  id                     String            @id @default(uuid()) @db.Uuid
  goodsReceiptId         String            @map("goods_receipt_id") @db.Uuid
  purchaseOrderLineId    String            @map("purchase_order_line_id") @db.Uuid
  quantityReceived       Decimal           @map("quantity_received") @db.Decimal(19, 4)
  quantityReceivedBefore Decimal?          @map("quantity_received_before") @db.Decimal(19, 4)
  balanceBefore          Decimal?          @map("balance_before") @db.Decimal(19, 4)
  balanceAfter           Decimal?          @map("balance_after") @db.Decimal(19, 4)
  movementId             String?           @unique @map("movement_id") @db.Uuid
  createdAt              DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  goodsReceipt           GoodsReceipt      @relation(fields: [goodsReceiptId], references: [id], onDelete: Cascade)
  purchaseOrderLine      PurchaseOrderLine @relation(fields: [purchaseOrderLineId], references: [id], onDelete: Restrict)
  movement               StockMovement?    @relation("GoodsReceiptMovement", fields: [movementId], references: [id], onDelete: Restrict)

  @@unique([goodsReceiptId, purchaseOrderLineId])
  @@index([purchaseOrderLineId])
  @@map("goods_receipt_lines")
}


model Customer {
  id            String   @id @default(uuid()) @db.Uuid
  code          String   @unique
  name          String
  contactName   String?  @map("contact_name")
  email         String?
  phone         String?
  taxNumber     String?  @unique @map("tax_number")
  addressLine1  String?  @map("address_line_1")
  addressLine2  String?  @map("address_line_2")
  city          String?
  stateProvince String?  @map("state_province")
  postalCode    String?  @map("postal_code")
  countryCode   String?  @map("country_code")
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  salesOrders   SalesOrder[]

  @@index([name])
  @@index([contactName])
  @@index([email])
  @@index([phone])
  @@index([countryCode])
  @@index([isActive, name])
  @@map("customers")
}


enum SalesOrderStatus {
  DRAFT
  CONFIRMED
  DISPATCHED
  COMPLETED
  CANCELLED
}

model SalesOrder {
  id                 String           @id @default(uuid()) @db.Uuid
  number             String           @unique
  customerId         String           @map("customer_id") @db.Uuid
  warehouseId        String           @map("warehouse_id") @db.Uuid
  orderDate          DateTime         @map("order_date") @db.Date
  notes              String?
  status             SalesOrderStatus @default(DRAFT)
  subtotal           Decimal          @default(0) @db.Decimal(19, 4)
  currencyCode       String           @map("currency_code") @db.VarChar(3)
  createdByUserId    String           @map("created_by_user_id") @db.Uuid
  confirmedByUserId  String?          @map("confirmed_by_user_id") @db.Uuid
  cancelledByUserId  String?          @map("cancelled_by_user_id") @db.Uuid
  dispatchedByUserId String?          @map("dispatched_by_user_id") @db.Uuid
  completedByUserId  String?          @map("completed_by_user_id") @db.Uuid
  confirmedAt        DateTime?        @map("confirmed_at") @db.Timestamptz(3)
  cancelledAt        DateTime?        @map("cancelled_at") @db.Timestamptz(3)
  dispatchedAt       DateTime?        @map("dispatched_at") @db.Timestamptz(3)
  completedAt        DateTime?        @map("completed_at") @db.Timestamptz(3)
  createdAt          DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  customer           Customer         @relation(fields: [customerId], references: [id], onDelete: Restrict)
  warehouse          Warehouse        @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  createdBy          User             @relation("SalesOrderCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  confirmedBy        User?            @relation("SalesOrderConfirmedBy", fields: [confirmedByUserId], references: [id], onDelete: Restrict)
  cancelledBy        User?            @relation("SalesOrderCancelledBy", fields: [cancelledByUserId], references: [id], onDelete: Restrict)
  dispatchedBy       User?            @relation("SalesOrderDispatchedBy", fields: [dispatchedByUserId], references: [id], onDelete: Restrict)
  completedBy        User?            @relation("SalesOrderCompletedBy", fields: [completedByUserId], references: [id], onDelete: Restrict)
  lines              SalesOrderLine[]
  returns            SalesReturn[]

  @@index([customerId, orderDate])
  @@index([warehouseId, orderDate])
  @@index([status, orderDate])
  @@index([createdByUserId])
  @@index([confirmedByUserId])
  @@index([cancelledByUserId])
  @@index([dispatchedByUserId])
  @@index([completedByUserId])
  @@index([createdAt])
  @@map("sales_orders")
}

model SalesOrderLine {
  id                 String        @id @default(uuid()) @db.Uuid
  salesOrderId       String        @map("sales_order_id") @db.Uuid
  productId          String        @map("product_id") @db.Uuid
  quantity           Decimal       @db.Decimal(19, 4)
  unitPrice          Decimal       @map("unit_price") @db.Decimal(19, 4)
  lineTotal          Decimal       @map("line_total") @db.Decimal(19, 4)
  quantityReserved   Decimal       @default(0) @map("quantity_reserved") @db.Decimal(19, 4)
  quantityDispatched Decimal       @default(0) @map("quantity_dispatched") @db.Decimal(19, 4)
  quantityReturned   Decimal       @default(0) @map("quantity_returned") @db.Decimal(19, 4)
  saleMovementId     String?       @unique @map("sale_movement_id") @db.Uuid
  createdAt          DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  salesOrder         SalesOrder    @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  product            Product       @relation(fields: [productId], references: [id], onDelete: Restrict)
  saleMovement       StockMovement? @relation("SalesOrderSaleMovement", fields: [saleMovementId], references: [id], onDelete: Restrict)
  salesReturnLines   SalesReturnLine[]

  @@unique([salesOrderId, productId])
  @@index([productId])
  @@map("sales_order_lines")
}

model SalesReturn {
  id              String            @id @default(uuid()) @db.Uuid
  number          String            @unique
  salesOrderId    String            @map("sales_order_id") @db.Uuid
  notes           String?
  createdByUserId String            @map("created_by_user_id") @db.Uuid
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  salesOrder      SalesOrder        @relation(fields: [salesOrderId], references: [id], onDelete: Restrict)
  createdBy       User              @relation("SalesReturnCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  lines           SalesReturnLine[]

  @@index([salesOrderId, createdAt])
  @@index([createdByUserId])
  @@map("sales_returns")
}

model SalesReturnLine {
  id               String         @id @default(uuid()) @db.Uuid
  salesReturnId    String         @map("sales_return_id") @db.Uuid
  salesOrderLineId String         @map("sales_order_line_id") @db.Uuid
  quantityReturned Decimal        @map("quantity_returned") @db.Decimal(19, 4)
  movementId       String         @unique @map("movement_id") @db.Uuid
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  salesReturn      SalesReturn    @relation(fields: [salesReturnId], references: [id], onDelete: Restrict)
  salesOrderLine   SalesOrderLine @relation(fields: [salesOrderLineId], references: [id], onDelete: Restrict)
  movement         StockMovement  @relation("SalesReturnMovement", fields: [movementId], references: [id], onDelete: Restrict)

  @@unique([salesReturnId, salesOrderLineId])
  @@index([salesOrderLineId])
  @@map("sales_return_lines")
}


enum StockCountStatus {
  DRAFT
  COUNTING
  SUBMITTED
  POSTED
  CANCELLED
}

model StockCount {
  id                String           @id @default(uuid()) @db.Uuid
  number            String           @unique
  warehouseId       String           @map("warehouse_id") @db.Uuid
  notes             String?
  status            StockCountStatus @default(DRAFT)
  createdByUserId   String           @map("created_by_user_id") @db.Uuid
  startedByUserId   String?          @map("started_by_user_id") @db.Uuid
  submittedByUserId String?          @map("submitted_by_user_id") @db.Uuid
  approvedByUserId  String?          @map("approved_by_user_id") @db.Uuid
  startedAt         DateTime?        @map("started_at") @db.Timestamptz(3)
  submittedAt       DateTime?        @map("submitted_at") @db.Timestamptz(3)
  approvedAt        DateTime?        @map("approved_at") @db.Timestamptz(3)
  postedAt          DateTime?        @map("posted_at") @db.Timestamptz(3)
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  warehouse         Warehouse        @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  createdBy         User             @relation("StockCountCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  startedBy         User?            @relation("StockCountStartedBy", fields: [startedByUserId], references: [id], onDelete: Restrict)
  submittedBy       User?            @relation("StockCountSubmittedBy", fields: [submittedByUserId], references: [id], onDelete: Restrict)
  approvedBy        User?            @relation("StockCountApprovedBy", fields: [approvedByUserId], references: [id], onDelete: Restrict)
  lines             StockCountLine[]

  @@index([warehouseId, createdAt])
  @@index([status, createdAt])
  @@index([createdByUserId])
  @@index([startedByUserId])
  @@index([submittedByUserId])
  @@index([approvedByUserId])
  @@map("stock_counts")
}

model StockCountLine {
  id                 String        @id @default(uuid()) @db.Uuid
  stockCountId       String        @map("stock_count_id") @db.Uuid
  productId          String        @map("product_id") @db.Uuid
  expectedQuantity   Decimal       @map("expected_quantity") @db.Decimal(19, 4)
  countedQuantity    Decimal?      @map("counted_quantity") @db.Decimal(19, 4)
  varianceQuantity   Decimal?      @map("variance_quantity") @db.Decimal(19, 4)
  snapshotUnitCost   Decimal       @map("snapshot_unit_cost") @db.Decimal(19, 4)
  balanceBefore      Decimal?      @map("balance_before") @db.Decimal(19, 4)
  balanceAfter       Decimal?      @map("balance_after") @db.Decimal(19, 4)
  movementId         String?       @unique @map("movement_id") @db.Uuid
  createdAt          DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  stockCount         StockCount    @relation(fields: [stockCountId], references: [id], onDelete: Cascade)
  product            Product       @relation(fields: [productId], references: [id], onDelete: Restrict)
  movement           StockMovement? @relation("StockCountMovement", fields: [movementId], references: [id], onDelete: Restrict)

  @@unique([stockCountId, productId])
  @@index([productId])
  @@index([stockCountId, varianceQuantity])
  @@map("stock_count_lines")
}
